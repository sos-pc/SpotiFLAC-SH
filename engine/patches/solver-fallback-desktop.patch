Upstream removed _run_manual_terminal_verification in 1.6.1 ("Verifica
manuale disabilitata per evitare blocchi del server"), collapsing the three
verification modes into two and raising RuntimeError directly instead of
calling the terminal fallback.

This rebases the external-solver fallback to anchor right before that
final RuntimeError in run_community_verification.  The logic is
unchanged: when TURNSTILE_SOLVER_URL is set, try the external solver; on
success return the grant; on any failure log a warning and fall through
to the same RuntimeError upstream would have raised anyway.

diff --git a/SpotiFLAC/core/signed_session_desktop.py b/SpotiFLAC/core/signed_session_desktop.py
--- a/SpotiFLAC/core/signed_session_desktop.py
+++ b/SpotiFLAC/core/signed_session_desktop.py
@@ -332,7 +332,27 @@
         except ImportError:
             logger.info("solver.py not found or Playwright dependencies missing.")
         except Exception as e:
             logger.warning(f"Automated verification failed: {e}")
+
+        # === MODO 3: Solver esterno (TURNSTILE_SOLVER_URL) ===
+        solver_url = os.environ.get("TURNSTILE_SOLVER_URL", "").rstrip("/")
+        if solver_url:
+            try:
+                resp = requests.post(
+                    f"{solver_url}/grant",
+                    json={"challenge_url": final_challenge_url},
+                    timeout=45,
+                )
+                resp.raise_for_status()
+                data = resp.json()
+                grant_ext = (data.get("grant") or "").strip()
+                if grant_ext:
+                    return grant_ext
+            except Exception as e:
+                logger.warning(
+                    "solver fallback failed for community session: %s", e
+                )
+
         raise RuntimeError(
             f"Verifica manuale disabilitata per evitare blocchi del server (challenge: {final_challenge_url})"
         )
